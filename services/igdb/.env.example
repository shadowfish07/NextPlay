TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
PORT=3000

# 仅供离线生成类型/主题词表；运行时游戏资料接口不会读取
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gemini-3-flash

# Opt-in private player history; never reuse Steam keys as history API tokens.
NEXTPLAY_HISTORY_ENABLED=false
NEXTPLAY_HISTORY_DIR=data/history
NEXTPLAY_HISTORY_MIN_FREE_BYTES=536870912
# JSON entries: id, steamId, apiKeyEnv, tokenEnv. Values below are examples only.
NEXTPLAY_HISTORY_ACCOUNTS=[]
# NEXTPLAY_HISTORY_STEAM_KEY=
# NEXTPLAY_HISTORY_API_TOKEN= (random token, at least 32 characters)
# OneDrive public-client app registration and a dedicated folder item ID.
NEXTPLAY_ONEDRIVE_CLIENT_ID=
NEXTPLAY_ONEDRIVE_TENANT=consumers
NEXTPLAY_ONEDRIVE_FOLDER_ID=
# Alternative: reuse an authorized rclone remote; leave CLIENT_ID empty.
NEXTPLAY_ONEDRIVE_RCLONE_REMOTE=
NEXTPLAY_RCLONE_BINARY=rclone
