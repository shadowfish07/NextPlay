# Copy this file to .env. The real .env is ignored by Git.
# Do not add quotes unless the value contains whitespace.

NEXTPLAY_STEAM_API_KEY=
NEXTPLAY_STEAM_ID=

# Optional local overrides.
NEXTPLAY_IGDB_LOCAL_URL=http://127.0.0.1:61000
NEXTPLAY_IGDB_PUBLIC_URL=https://igdb.zqydev.me
NEXTPLAY_AVD=Pixel_7_Pro_API_36
# How long an Android E2E run waits for another worktree to release the AVD.
NEXTPLAY_ANDROID_LEASE_TIMEOUT_SECONDS=900
